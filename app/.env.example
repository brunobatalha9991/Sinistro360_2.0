# Por padrão o app roda 100% OFFLINE (dados fictícios em localStorage,
# nenhuma chamada de rede). Não mude isso sem um projeto Firebase separado
# de DESENVOLVIMENTO — nunca aponte para o projeto de produção.
VITE_DATA_SOURCE=offline

# Só usado se VITE_DATA_SOURCE=firebase. Preencha com as credenciais de um
# projeto Firebase de TESTE (Firebase Console → seu projeto de dev →
# Configurações do projeto → apps → SDK config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave da API do Google Gemini (Google AI Studio) — usada DIRETO do
# navegador (sem backend/proxy), fica visível no bundle. Gere em
# https://aistudio.google.com/apikey e, se possível, restrinja por domínio/
# referrer no Google Cloud Console. Sem esta chave, o módulo "Assistente IA"
# fica desabilitado.
VITE_GEMINI_API_KEY=
# Nome do modelo Gemini — muda com frequência, mantenha configurável.
# Ver modelos disponíveis em https://ai.google.dev/gemini-api/docs/models
VITE_GEMINI_MODEL=gemini-3.6-flash
